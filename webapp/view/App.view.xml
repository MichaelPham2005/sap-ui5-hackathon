<!--
  YOUR APP SHELL. Keep <App id="app" /> and navigation keys page1, page2 and page3.
  You can copy an alternative shell from the deployed workshop and paste it between the markers.
-->
<mvc:View
  controllerName="workshop.dashboard.controller.App"
  xmlns="sap.m"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:f="sap.f"
  xmlns:tnt="sap.tnt"
  displayBlock="true"
  height="100%"
>
<!-- 🧩 SHELL START -->
<tnt:ToolPage id="toolPage">
  <tnt:header>
    <f:ShellBar homeIcon="{app>/logo}" title="My app: rename me" />
  </tnt:header>
  <tnt:subHeader>
    <IconTabHeader id="nav" selectedKey="page1" select=".onNavSelect" backgroundDesign="Solid">
      <items>
        <IconTabFilter key="page1" text="The answer" />
        <IconTabFilter key="page2" text="Page 2" />
        <IconTabFilter key="page3" text="Page 3" />
      </items>
    </IconTabHeader>
  </tnt:subHeader>
  <tnt:mainContents>
    <App id="app" autoFocus="false" />
  </tnt:mainContents>
</tnt:ToolPage>
<!-- 🧩 SHELL END -->
</mvc:View>
